{
  "name": "dsh-gemini-oauth",
  "version": "0.2.2",
  "private": true,
  "description": "\u72ec\u7acb\u3001\u672c\u673a\u6301\u6709\u7684 Gemini provider \u2014\u2014 \u901a\u8fc7 Google Antigravity / Cloud Code Assist \u8ba2\u9605 OAuth (PKCE) \u767b\u5f55\uff0c\u4e0d\u78b0 console API key\u3002\u53ef\u89c6\u4e3a dsh-grok-oauth \u7684 Gemini \u5bf9\u5e94\u7269\u3002v0.2 \u652f\u6301\u591a\u8d26\u53f7\u4fdd\u5b58/\u5207\u6362/\u79fb\u9664\u3002",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "dev": "node scripts/build.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test-loader.mjs test-store.mjs && node --import ./test-loader.mjs test-routes.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "undici": "^7.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": ">=0.1.0-rc.6 <0.1.1 || >=0.1.1-rc.1 <1.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.1.1 || >=0.1.1-rc.1 <1.0.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <0.1.1 || >=0.1.1-rc.1 <1.0.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackAIStudio/dsh-gemini-oauth.git"
  },
  "homepage": "https://github.com/JackAIStudio/dsh-gemini-oauth#readme"
}