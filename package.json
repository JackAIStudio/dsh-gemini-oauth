{
  "name": "dsh-gemini-oauth",
  "version": "0.2.1",
  "private": true,
  "description": "独立、本机持有的 Gemini provider —— 通过 Google Antigravity / Cloud Code Assist 订阅 OAuth (PKCE) 登录，不碰 console API key。可视为 dsh-grok-oauth 的 Gemini 对应物。v0.2 支持多账号保存/切换/移除。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "dev": "node scripts/build.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test-loader.mjs test-store.mjs && node --import ./test-loader.mjs test-routes.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "undici": "^7.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": ">=0.1.0-rc.6 <0.1.1 || >=0.1.1-rc.1 <1.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.1.1 || >=0.1.1-rc.1 <1.0.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <0.1.1 || >=0.1.1-rc.1 <1.0.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackAIStudio/dsh-gemini-oauth.git"
  },
  "homepage": "https://github.com/JackAIStudio/dsh-gemini-oauth#readme"
}
